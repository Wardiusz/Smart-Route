# SmartRoute – przykładowe zmienne środowiskowe.
# Skopiuj do .env (lub ustaw w środowisku) i uzupełnij wartości.

# --- AI (opcjonalne) ---
# Bez klucza rekomendacje działają offline (heurystyka).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# --- JWT (wymagane) ---
# Dwa RÓŻNE sekrety, każdy min. 32 znaki (HMAC-SHA256 = klucz >= 256 bitów).
# Wygeneruj np.: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long

# Czasy życia tokenów (format java.time.Duration, np. 15m, 1h, 7d).
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Konta demo ---
# demo@smartroute.pl / demo1234 (USER), admin@smartroute.pl / admin1234 (ADMIN).
# W produkcji ustaw false.
DEMO_USERS_ENABLED=true

# --- Mapy i dane o miejscach (opcjonalne, domyślnie publiczne serwery) ---
# Wyszukiwarka miejscowości (Photon).
GEOCODING_URL=https://photon.komoot.io
# Trasy po drogach (OSRM). Pusty = linie proste.
ROAD_ROUTING_URL=https://routing.openstreetmap.de
# Katalog atrakcji z Wikidata, zapisywany w pliku i odświeżany co POI_CATALOG_MAX_AGE.
# Pusty POI_CATALOG_SPARQL_URL = tylko plik (bez pobierania).
POI_CATALOG_SPARQL_URL=https://query.wikidata.org/sparql
POI_CATALOG_FILE=data/poi-catalog.json
POI_CATALOG_MAX_AGE=30d
